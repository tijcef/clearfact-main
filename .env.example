# Public Supabase configuration used by the contributor and newsroom tools.
# Set real values in Cloudflare and in your local .env file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only rate-limit connection: copy from WordPress Settings > ClearFact Services.
# Configure as a Cloudflare Worker secret; never prefix with VITE_.
CLEARFACT_SERVICES_SECRET=
